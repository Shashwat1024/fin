{
  "name": "fin",
  "productName": "Fin",
  "version": "2.4.0",
  "description": "Private, local-first personal finance tracker",
  "private": true,
  "type": "module",
  "author": "Shashwat",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node scripts/vitest.mjs run",
    "test:watch": "node scripts/vitest.mjs",
    "test:coverage": "node scripts/vitest.mjs run --coverage",
    "test:e2e": "tauri build --debug --no-bundle && playwright test",
    "package": "tauri build",
    "seed:perf": "node scripts/seed-perf.mjs",
    "dev:renderer": "vite --config vite.renderer.config.ts",
    "build:renderer": "vite build --config vite.renderer.config.ts",
    "tauri": "tauri",
    "test:rust": "cargo test --workspace && node scripts/vitest.mjs run --config vitest.parity.config.ts",
    "test:parity": "node scripts/vitest.mjs run --config vitest.parity.config.ts",
    "test:perf": "cargo test --release -p fin-core --test perf -- --ignored --nocapture"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "pdfjs-dist": "4.10.38",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "^24.19.2",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.11.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "date-fns": "^4.4.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "lucide-react": "^1.70.0",
    "papaparse": "^5.7.0",
    "prettier": "^3.9.10",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
